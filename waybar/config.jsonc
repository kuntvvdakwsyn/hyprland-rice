{
  "include": [
    "~/.config/waybar/modules.jsonc"
    ],
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 10,
    "margin":"6px 15px -4px 15px",
    "exclusive": true,

    "spacing": 10,

    "modules-left": [
      "custom/scripts",
      "custom/separator",
      "hyprland/workspaces",
      "custom/separator",
      "hyprland/window"
    ],
    "modules-center": [
      "clock"

    ],

    "modules-right": [
      "network",
      "custom/separator",
      "pulseaudio",
      "custom/separator",
      "battery", 
      "custom/separator",
      "memory"
    ]
}
