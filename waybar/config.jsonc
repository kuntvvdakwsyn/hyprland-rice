{
  "include": [
    "~/.config/waybar/modules.jsonc"
    ],
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 6,
    "margin": "8px 18px 6px 18px",
    "exclusive": true,

    "spacing": 10,

    "modules-left": [
      "custom/my-power",
      "hyprland/workspaces",
      "hyprland/window",
    ],
    "modules-center": [
      "clock",

    ],

    "modules-right": [
      "network",
      "pulseaudio",
      "battery", 
      "memory"
    ]
}
